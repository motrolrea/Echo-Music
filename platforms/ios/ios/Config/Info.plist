<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>moumusic</string>
            </array>
        </dict>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.jiajia2222.moumusic.provider-refresh</string>
    </array>
    <key>MOUMUSIC_SERVER_URL</key>
    <string>$(MOUMUSIC_SERVER_URL)</string>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于把赞赏码保存到相册，方便用微信扫码。</string>
    <key>NSHealthShareUsageDescription</key>
    <string>读取耳机音量、心率、活动能量，以及健康里的步行、跑步、骑行体能训练，用于设备统计和锻炼记录。没有数据时不显示数值。</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>结束锻炼时可以把这次运动写入健康 App。拒绝写入不影响本次页面上的记录。</string>
    <key>NSMotionUsageDescription</key>
    <string>锻炼时读取步数、距离、配速和楼层。这台手机不支持的项目会显示为无数据。</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- CarPlay scene metadata is injected only by make configure-carplay. -->
</dict>
</plist>
